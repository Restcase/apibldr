# Public build-time settings. Never put credentials in VITE_* variables.
# Optional compatible generator; leave blank to disable code generation.
VITE_GENERATOR_URL=

# Optional feedback overrides; public identifiers, not API credentials.
# Omit to use ApiBldr's existing Appzi form. Set both empty to disable it.
# VITE_APPZI_PORTAL=your-public-portal-id
# VITE_APPZI_SURVEY=your-public-survey-id
